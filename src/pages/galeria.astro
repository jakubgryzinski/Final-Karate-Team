import Karate1 from "../assets/images/karate-1.jpg";
import Karate2 from "../assets/images/karate-2.jpg";
import Karate3 from "../assets/images/karate-3.jpg";
import Carousel from "../components/Carousel"

let images = [
  Karate1,
  Karate2,
  Karate3,
  Karate1,
  Karate2,
  Karate3,
  Karate1,
  Karate2,
  Karate3,
  Karate1,
  Karate2,

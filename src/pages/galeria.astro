---


<Layout title="Karate Team Oborniki">
  <main class="min-h-screen flex justify-center md:pt-40 md:pb-20 py-28">
    {$isOpen ? (
      <Gallery images={images}/>
    ) : null}
    <Carousel client:only images={images}/>
  </main>
</Layout>

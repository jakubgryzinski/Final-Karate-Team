---
import Layout from "../layouts/Layout.astro";
import Instructors from "../components/Instructors.astro";

const response = await fetch('https://graphql.datocms.com/', {
  method: 'POST',
  headers: {
    'Content-Type': 'application/json',
    Accept: 'application/json',
    Authorization: `Bearer ${import.meta.env.DATOCMS_API_KEY}`,
  },
  body: JSON.stringify({
    query: `query InstructorsPage {
              allInstructors {
                title
                paragraph
                instructorModule {
                  title
                  description
                  alt
                  photo {
                    url
                    width
                    height
                  }
                }
              }
            }
      `,
  }),
});

const json = await response.json();
const data = json.data.allInstructors;
---

<Layout title="Karate Team Oborniki">
  <main class="min-h-screen flex justify-center md:pt-40 md:pb-20 py-28">
    <Instructors Items={data}/>
  </main>
</Layout>

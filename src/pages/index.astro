---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import Section from "../components/Section.astro";
import { SectionsItems, HeroItems, FeaturesItems } from "../assets/items/HomeItems.astro"
import { Debug } from 'astro:components';

const response = await fetch('https://graphql.datocms.com/', {
  method: 'POST',
  headers: {
    'Content-Type': 'application/json',
    Accept: 'application/json',
    Authorization: `Bearer ${import.meta.env.DATOCMS_API_KEY}`,
  },
  body: JSON.stringify({
    query: `query homePage {
      allHomepages {
        button
        title
        href
        photo {
          url
          width
          height
        }
        content {
          ... on PhotoDescriptionRecord {
            __typename
            title
            description
            alt
            photo {
              url
              width
              height
            }
          }
          ... on FeaturesModuleRecord {
            __typename
            title
            paragraph
            iconOne {
              url
            }
            titleOne
            descriptionOne
            iconTwo {
              url
            }
            titleTwo
            descriptionTwo
            iconThree {
              url
            }
            titleThree
            descriptionThree
            iconFour {
              url
            }
            titleFour
            descriptionFour
            iconFive {
              url
            }
            titleFive
            descriptionFive
            iconSix {
              url
            }
            titleSix
            descriptionSix
          }
        }
      }
    }
      `,
  }),
});

const json = await response.json();
const data = json.data.allHomepages[0];
const content = data.content;

let index = 1;
---

<Layout title="Karate Team Oborniki">
  <main>
    <Hero image={data.photo} title={data.title} button={data.button} href={data.href} />
  {
    content.map(({__typename, title, description, alt, photo}) => {
        switch (__typename) {
          case "PhotoDescriptionRecord":
            index += 1;
            return (
              <section class="2xl:max-w-screen-2xl w-full xl:px-4 px-8 flex flex-col md:gap-36  gap-12 my-32 m-auto">
                <Section title={title} description={description} image={photo} alt={alt} i={index}/>
              </section>
            )
          case "FeaturesModuleRecord":
            return <Features items={FeaturesItems}/>
          default:
            break;
      }
    })
  }
  </main>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import Section from "../components/Section.astro";

const response = await fetch('https://graphql.datocms.com/', {
  method: 'POST',
  headers: {
    'Content-Type': 'application/json',
    Accept: 'application/json',
    Authorization: `Bearer ${import.meta.env.DATOCMS_API_KEY}`,
  },
  body: JSON.stringify({
    query: `query homePage {
      allHomepages {
        button
        title
        href
        photo {
          url
          width
          height
        }
        content {
          ... on PhotoDescriptionRecord {
            __typename
            title
            description
            alt
            photo {
              url
              width
              height
            }
          }
          ... on FeaturesModuleRecord {
            __typename
            title
            paragraph

            iconOne
            titleOne
            descriptionOne

            iconTwo
            titleTwo
            descriptionTwo

            iconThree
            titleThree
            descriptionThree

            iconFour
            titleFour
            descriptionFour

            iconFive
            titleFive
            descriptionFive

            iconSix
            titleSix
            descriptionSix
          }
        }
      }
    }
      `,
  }),
});

const json = await response.json();
const data = json.data.allHomepages[0];
const content = data.content;

let index = 1;
---

<Layout title="Karate Team Oborniki">
  <main>
    <Hero photo={data.photo} title={data.title} button={data.button} href={data.href} />
  {
    content.map((item) => {
        switch (item.__typename) {
          case "PhotoDescriptionRecord":
            index += 1;
            return (
              <section class="2xl:max-w-screen-2xl w-full xl:px-4 px-8 flex flex-col md:gap-36  gap-12 my-32 m-auto">
                <Section title={item.title} description={item.description} image={item.photo} alt={item.alt} i={index}/>
              </section>
            )
          case "FeaturesModuleRecord":
            return <Features cms={item}/>
          default:
            break;
      }
    })
  }
  </main>
</Layout>

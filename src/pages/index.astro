---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import Section from "../components/Section.astro";
import { SectionsItems, HeroItems, FeaturesItems } from "../assets/items/HomeItems.astro"
---

<Layout title="Karate Team Oborniki">
  <main>
    <Hero image={HeroItems.image} title={HeroItems.title} button={HeroItems.button} href={HeroItems.href} />
    <section class="2xl:max-w-screen-2xl w-full xl:px-4 px-8 flex flex-col md:gap-36  gap-12 my-32 m-auto">
      <Section title={SectionsItems[0].title} description={SectionsItems[0].paragraph} image={SectionsItems[0].image} i={0}/>
    </section>
   <Features items={FeaturesItems}/>
   <section class="2xl:max-w-screen-2xl w-full xl:px-4 px-8 flex flex-col md:gap-36  gap-12 my-32 m-auto">
    <Section title={SectionsItems[1].title} description={SectionsItems[1].paragraph} image={SectionsItems[1].image} i={1}/>
  </section>
  </main>
</Layout>

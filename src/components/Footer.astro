---
import { Image } from "astro:assets";
import LogoImage from "../assets/images/logo.jpeg";
import SocialsIcons from "./SocialsIcons.astro";
---

<footer class="w-full h-52 backdrop-blur-md tracking-wide">
  <div class="2xl:max-w-screen-2xl mx-auto px-0 md:px-4 py-8 w-full">
    <div
      class="md:flex md:flex-row md:items-center justify-between flex flex-col items-start px-8"
    >
      <a
        href="/"
        class="flex gap-4 justify-start items-center text-light hover:text-gray-300 text-lg"
      >
        <Image src={LogoImage} alt="Logo" class="rounded-full md:w-12 w-14" />
        <span> Karate Team Oborniki</span>
      </a>
      <ul class="gap-8 md:text-base text-lg flex mt-8 md:mt-0">
        <li class="text-light hover:text-gray-300 transition-all">
          <a href="/instruktorzy">Instruktorzy</a>
        </li>
        <li class="text-light hover:text-gray-300 transition-all">
          <a href="/galeria">Galeria</a>
        </li>
        <li class="text-light hover:text-gray-300 transition-all">
          <a href="/kontakt">Kontakt</a>
        </li>
      </ul>
    </div>
    <hr class="border-gray-200 sm:mx-auto dark:border-gray-700 my-8" />
    <div
      class="md:flex md:flex-row md:items-center justify-between flex flex-col items-start px-8"
    >
      <span class="flex justify-center gap-16 md:flex-row flex-col-reverse">
        <a
          href="/"
          class="text-light hover:text-gray-300 flex justify-start md:justify-center items-center gap-4 text-lg"
        >
          <svg
            class="text-primary"
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
            ></path><polyline points="22,6 12,13 2,6"></polyline></svg
          >
           blochacademy@gmail.com
        </a>
        <a
          href="/"
          class="text-light hover:text-gray-300 flex justify-start md:justify-center items-center gap-4 text-lg"
        >
          <svg
            class="text-primary"
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
            ></path></svg
          >
           696 162 080
        </a>
      </span>
      <span class="mt-8 md:m-0">
        <SocialsIcons />
      </span>
    </div>
    <span
      class="block text-xl text-gray-500 md:text-center dark:text-gray-400 mt-16 px-8 md:p-0"
    >
      <a href="https://flowbite.com/" class="hover:underline"
        >Create By JayCode</a
      >
    </span>
  </div>
</footer>

---
import SocialsIcons from "./SocialsIcons.astro";
import { ContactItems } from "../assets/items/ContactItems.astro";
---

<section
  class="2xl:max-w-screen-2xl w-full min-h-full flex md:flex-row flex-col justify-center p-4 gap-4 md:gap-0 animate-in"
>
  <div class="md:w-1/2 p-4 md:p-16 2xl:pr-14 2xl:pl-24">
    <div
      class="w-full h-full justify-between flex flex-col py-10 md:gap-0 gap-32"
    >
      <span class="flex flex-col w-full justify-center items-center gap-28">
        <a
          href="/"
          class="text-light hover:text-gray-300 flex justify-start md:justify-center items-center gap-4 2xltext-3xl text-xl"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="45"
            height="45"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#F11B25"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"
            ></path><circle cx="12" cy="10" r="3"></circle></svg
          >
           {ContactItems.address}
        </a>
        <a
          href="/"
          class="text-light hover:text-gray-300 flex justify-start md:justify-center items-center gap-4 2xltext-3xl text-xl"
        >
          <svg
            class="text-primary"
            xmlns="http://www.w3.org/2000/svg"
            width="45"
            height="45"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
            ></path><polyline points="22,6 12,13 2,6"></polyline></svg
          >
            {ContactItems.email}
        </a>
        <a
          href="/"
          class="text-light hover:text-gray-300 flex justify-start md:justify-center items-center gap-4 2xltext-3xl text-xl"
        >
          <svg
            class="text-primary"
            xmlns="http://www.w3.org/2000/svg"
            width="45"
            height="45"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
            ></path></svg
          >
           {ContactItems.phone}
        </a>
      </span>
      <span class="w-full flex justify-center">
        <SocialsIcons />
      </span>
    </div>
  </div>
  <span class="md:w-[3px] w-full rounded-full md:h-full h-[3px] bg-light"
  ></span>
  <div class="md:w-1/2 p-4 md:p-16 md:h-auto h-[40rem] 2xl:pr-14 2xl:pl-24">
    <div class="w-full h-full">
      <iframe
        class="w-full h-full"
        title="mapa"
        allowfullscreen
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2420.984138782941!2d16.81528761613564!3d52.64219957983751!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47046cb8d617b447%3A0xb0787118b66f1468!2sGo%C5%82aszy%C5%84ska%2035%2C%2064-600%20Oborniki!5e0!3m2!1spl!2spl!4v1660782076893!5m2!1spl!2spl"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>
</section>

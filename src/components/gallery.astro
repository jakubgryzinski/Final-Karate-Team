---
import { Image } from "astro:assets";
const { images } = Astro.props;
---


<section class="2xl:max-w-screen-2xl w-full px-4">
  <h1 class="text-center text-light text-5xl font-bold">Galeria</h1>
  <div
    class="w-full grid 2xl:grid-cols-4 md:grid-cols-3 grid-cols-2 gap-8 mt-12"
  >
 {
images.map(({image}, i) => (
  <div class="w-full aspect-[4/3] item" id={i + 1}>
      <Image
        alt="image"
        id="openDialog"
        src={image}
        class="w-full h-full object-cover rounded-xl cursor-pointer"
      />
    </div>
  ))
 }
 </div>
  <span class="block text-xl text-gray-400 md:text-center mt-16 px-8 md:p-0">
    <a
      href="https://www.facebook.com/karateteamoborniki/photos"
      target="_blank"
      class="hover:underline">Zobacz więcej na naszym Facebooku</a
    >
  </span>
</section>


<script>

  import {  setIndex, $isOpen } from "../store"

  const items = document.getElementsByClassName('item');

  const itemsArray = [...items];


  itemsArray.forEach((item) => {
    item.addEventListener('click', (event) => {
      $isOpen.set(true);
      setIndex( parseInt(item.id))
  });
    
})
</script>
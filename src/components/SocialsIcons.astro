---
import { SocialMediaItems } from "../assets/items/SocialMediaItems.astro";
import Icon from "./Icon.astro";
import FaceBookIcon from "../assets/icons/facebook.svg?raw"
import InstagramIcon from "../assets/icons/instagram.svg?raw"
import YoutubeIcon from "../assets/icons/youtube.svg?raw"

const response = await fetch('https://graphql.datocms.com/', {
  method: 'POST',
  headers: {
    'Content-Type': 'application/json',
    Accept: 'application/json',
    Authorization: `Bearer ${import.meta.env.DATOCMS_API_KEY}`,
  },
  body: JSON.stringify({
    query: `query galleryPage {
      allContacts {
        facebook
        instagram
        youtube
      }
    }
      `,
  }),
});

const json = await response.json();
const data = json.data.allContacts[0];
---

<ul class="gap-8 flex">
  <li>
    <a
      target="_blank"
      href={data.facebook}
    >
    <Icon icon={FaceBookIcon}/>
    </a>
  </li>
  <li>
    <a
      target="_blank"
      href={data.instagram}
    >
    <Icon icon={InstagramIcon}/>
    </a>
  </li>
  <li>
    <a
      target="_blank"
      href={data.youtube}
    >
    <Icon icon={YoutubeIcon}/>
    </a>
  </li>
</ul>

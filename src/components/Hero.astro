---
interface Props {
    title: string,
    button: string,
    href: string,
    image: {
      url: ImageMetadata,
      width: number,
      height: number,
    }
}

import { Image } from "astro:assets";
import Button from "./Button.astro";

const { image, title, button, href  } = Astro.props;
---

<section class="relative w-full h-screen overflow-hidden">
  <Image
    src={image.url}
    width={image.width}
    height={image.height}
    alt="Hero Image"
    class="h-screen object-cover absolute top-0 left-0 w-full z-0 animate-fade-in"
  />
  <div class="absolute w-full h-full top-0 left-0 opacity-50 bg-black z-10">
  </div>
  <header
    class="absolute top-1/3 2xl:max-w-7xl 2xl:left-24 md:max-w-4xl md:left-16 max-w-lg px-8 z-20"
  >
    <h1
      class="2xl:text-7xl 2xl:leading-snug md:leading-snug md:text-5xl font-bold tracking-wide text-light text-4xl leading-relaxed animate-in"
      style="animation-delay: 0.3s;"
    >
      {title}
    </h1>
    <a
      href={href} 
      class="md:mt-16 md:ml-20 mt-20 ml-4 animate-in"
      style="animation-delay: 0.6s;"
    >
      <Button title={button} />
    </a>
  </header>
</section>

---
import { Image } from "astro:assets";
import HeroImage from "../assets/images/hero.jpg";
---

<section class="relative w-full h-screen">
  <Image
    src={HeroImage}
    alt="efb"
    class="h-screen object-cover opacity-40 absolute top-0 left-0 w-full"
  />
  <header
    class="absolute top-1/3 2xl:max-w-6xl md:max-w-3xl transform 2xl:left-24 md:left-16 max-w-sm px-8"
  >
    <h1
      class="2xl:text-7xl font-bold text-light 2xl:leading-snug md:leading-snug md:text-5xl text-4xl leading-relaxed"
    >
      Sport jako Pasja i Przygoda na całe Życie - Zacznij ją z Nami
    </h1>
  </header>
</section>

---
import { NavigationItems } from "../assets/items/navigation.astro";
---

<button
    id="button"
    class={`md:hidden inline-flex items-center w-10 h-10 justify-center text-sm  rounded-lg  text-light`}
    data-collapse-toggle="navbar-default"
    type="button"
    aria-controls="navbar-default"
    aria-expanded="false"
>
    <span class="sr-only">Open main menu</span>
    <svg
    class="w-5 h-5"
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 17 14"
    >
        <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 1h15M1 7h15M1 13h15"
        ></path>
    </svg>
</button>
<div
    id="menu"
    class={`w-full px-2 top-20 left-0 z-0 hidden`}
>
    <ul class="font-medium flex flex-col p-4 md:p-0 mt-2 rounded-lg bg-white/10 backdrop-blur-md tracking-wide">
        {NavigationItems.map(({href, title}) => (
        <li>
            <a
            href={href}
            class="block py-2 pl-3 pr-4 rounded text-light hover:bg-black/20 "
            >
                {title}
            </a>
        </li>    
        ))}
    </ul>
</div>

<script>

let isOpen = false;

const button = document.getElementById("button")
const menu = document.getElementById("menu")


const handleClickListener = (e: any) => {
    if (
      button?.contains(e.target) ||
      menu?.contains(e.target)
    ) {
      return;
    } else {
        isOpen = false
        menu?.classList.remove("fixed")
        menu?.classList.add("hidden")

        button?.classList.remove("text-gray-500")
        button?.classList.add("text-light")
    }
  };

const toggleIsOpen = () => {
    isOpen = !isOpen
    if(isOpen){
        menu?.classList.remove("hidden")
        menu?.classList.add("fixed")

        button?.classList.remove("text-light")
        button?.classList.add("text-gray-500")
    } else {
        menu?.classList.remove("fixed")
        menu?.classList.add("hidden")

        button?.classList.remove("text-gray-500")
        button?.classList.add("text-light")
    }
};

document.addEventListener("mousedown", handleClickListener);
button?.addEventListener("mousedown", toggleIsOpen)
</script>
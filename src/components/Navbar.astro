---
import { Image } from "astro:assets";
import LogoImage from "../assets/images/logo.jpeg";
import SocialsIcons from "./SocialsIcons.astro";
import MobileMenu from "./MobileMenu.astro";
import { NavigationItems } from "../assets/items/navigation.astro";
---

<span class="fixed top-0 z-40 w-full bg-white/10 backdrop-blur-md tracking-wide h-20 md:h-24"/>
<nav
  class="fixed top-0 z-40 flex items-center justify-between w-full px-2 md:px-12 xl:px-24 2xl:px-52 md:h-24 h-20 p-2 text-white"
>
  <span class="flex items-center md:gap-12 gap-4">
    <a href="/">
      <Image src={LogoImage} alt="Logo" class="rounded-full md:w-20 w-14" />
    </a>
    <a href="/" class="md:hidden flex text-lg text-light hover:text-gray-300"
      >Karate Team Oborniki</a
    >
    <ul class="gap-8 text-xl md:flex hidden">
      {
        NavigationItems.map(({href, title}) => (
        <li class="text-light hover:text-gray-300 transition-all">
          <a href={href}>{title}</a>
        </li>    
        ))
      }
    </ul>
  </span>
  <span class="md:flex hidden">
    <SocialsIcons />
  </span>
    <MobileMenu/>
</nav>

---
interface Props {
    title: string,
}

const { title } = Astro.props;
---

<button
  class="border-4 border-primary px-8 py-4 flex justify-center items-center rounded-xl text-gray-200 text-lg md:text-2xl hover:text-gray-light hover:bg-white/10 transition-all hover:backdrop-blur-md hover:border-primaryHover"
>
  {title}
</button>

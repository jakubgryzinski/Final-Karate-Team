---
interface Props {
  Items: Array <{
    title: string,
    description: string,
    alt: string,
    image: {
      url: ImageMetadata,
      width: number,
      height: number,
    }
  }>
}

import Section from "./Section.astro";
const { Items } = Astro.props as Props;
---

<section class="2xl:max-w-screen-2xl w-full xl:px-4 px-8 flex flex-col md:gap-36  gap-12">
    {
      Items.map(({title, description, image, alt}, i) => (
        <Section title={title} description={description} image={image} alt={alt} i={i}/>
      ))
    }
</section>
